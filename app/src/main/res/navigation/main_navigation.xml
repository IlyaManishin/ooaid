<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_navigation"
    app:startDestination="@id/home_tab">
    <navigation
        android:id="@+id/home_tab"
        app:startDestination="@id/home_screen">
        <fragment
            android:id="@+id/home_screen"
            android:name="app.trackfit.app.ui.TabFragment"
            android:label="@string/tab_home">
            <argument
                android:name="title"
                android:defaultValue="@string/tab_home"
                app:argType="reference" />
        </fragment>
    </navigation>
    <navigation
        android:id="@+id/progress_tab"
        app:startDestination="@id/progress_screen">
        <fragment
            android:id="@+id/progress_screen"
            android:name="app.trackfit.app.ui.TabFragment"
            android:label="@string/tab_progress">
            <argument
                android:name="title"
                android:defaultValue="@string/tab_progress"
                app:argType="reference" />
        </fragment>
    </navigation>
    <navigation
        android:id="@+id/coach_tab"
        app:startDestination="@id/coach_screen">
        <fragment
            android:id="@+id/coach_screen"
            android:name="app.trackfit.app.ui.TabFragment"
            android:label="@string/tab_coach">
            <argument
                android:name="title"
                android:defaultValue="@string/tab_coach"
                app:argType="reference" />
        </fragment>
    </navigation>
    <navigation
        android:id="@+id/profile_tab"
        app:startDestination="@id/profile_screen">
        <fragment
            android:id="@+id/profile_screen"
            android:name="app.trackfit.app.ui.TabFragment"
            android:label="@string/tab_profile">
            <argument
                android:name="title"
                android:defaultValue="@string/tab_profile"
                app:argType="reference" />
        </fragment>
    </navigation>
</navigation>
