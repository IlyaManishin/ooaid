          <mxGeometry x="268" y="228" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1-s1c-p2-go" value="&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#15803d;fontStyle=1;fontSize=14;" parent="p1-s1c" vertex="1">
          <mxGeometry x="312" y="228" width="40" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1-s1c-p3" value="&lt;b&gt;Фитнес и тонус&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#64748b&#39;&gt;Поддержание формы • Цикл: 5 дней (3 раб • 2 отд)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;spacingLeft=66;" parent="p1-s1c" vertex="1">
