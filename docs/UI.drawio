        <mxCell id="p1-s1a-rest" value="&lt;b&gt;Если сегодня «День отдыха»:&lt;/b&gt; кнопка старта скрыта, новый день откроется в 00:00." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=10;" parent="p1-s1a" vertex="1">
