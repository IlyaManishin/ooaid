        <mxCell id="DR7aE4fDn-D8mJDxJg3N-26" value="📋 Список программ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="DR7aE4fDn-D8mJDxJg3N-23">
