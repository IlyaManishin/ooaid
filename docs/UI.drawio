        <mxCell id="p1-s1a-d3" value="&lt;b&gt;18.11&lt;/b&gt;&lt;br&gt;День отдыха&lt;br&gt;🔒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#64748b;fontSize=10;" parent="p1-s1a" vertex="1">
