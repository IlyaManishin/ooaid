        <mxCell id="DR7aE4fDn-D8mJDxJg3N-2" value="ЭКРАН 1: Главная (Dashboard / Текущий цикл и расписание)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#343a40;fontStyle=1;fontSize=13;rounded=1;arcSize=2;" vertex="1" parent="1">
