        <mxCell id="p1-s1c-hdr" value="&lt;b&gt;← Мои программы&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#64748b&#39;&gt;Выберите программу, чтобы начать тренировку&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=14;fontSize=13;" parent="p1-s1c" vertex="1">
          <mxGeometry y="30" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p1-s1c-p1" value="&lt;b&gt;Сила и масса&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#64748b&#39;&gt;Базовая программа • Цикл: 4 дня (3 раб • 1 отд)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;spacingLeft=66;" parent="p1-s1c" vertex="1">
