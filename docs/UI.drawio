        <mxCell id="p2-s2a-addr" value="➕ День отдыха" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;dashed=1;fontColor=#334155;fontStyle=1;fontSize=12;" parent="p2-s2a" vertex="1">
