        <mxCell id="p2-e5" value="Вернуться к списку дней" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;dashed=1;strokeColor=#475569;fontColor=#334155;fontStyle=1;fontSize=11;" parent="1" source="p2-s2c-done" target="p2-s2a" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1180" y="960" />
              <mxPoint x="255" y="960" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
