        <mxCell id="DR7aE4fDn-D8mJDxJg3N-27" value="👤 Профиль и рекорды" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ced4da;align=left;spacingLeft=10;" vertex="1" parent="DR7aE4fDn-D8mJDxJg3N-23">
          <mxGeometry x="15" y="142" width="200" height="36" as="geometry" />
