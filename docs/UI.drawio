        <mxCell id="p1-s1c-p2" value="&lt;b&gt;Ноги и ягодицы&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#64748b&#39;&gt;Фокус на низ тела • Цикл: 3 дня (2 раб • 1 отд)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;spacingLeft=66;" parent="p1-s1c" vertex="1">
