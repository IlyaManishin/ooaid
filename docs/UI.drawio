        <mxCell id="p2-s2c-hdr" value="&lt;b&gt;← Работа 1 — Верх тела&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#64748b&#39;&gt;Редактирование тренировочного дня&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=14;fontSize=13;" parent="p2-s2c" vertex="1">
